{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "sirv dist --host 0.0.0.0 --port 3001",
    "astro": "astro",
    "docker:build": "docker build --platform linux/amd64 -t awaghray/portfolio:latest .",
    "docker:push": "docker push awaghray/portfolio:latest",
    "docker:publish": "npm run docker:build && npm run docker:push"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.13.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "sirv-cli": "^3.0.1"
  }
}
